{
 "cleanUrls": false,
 "trailingSlash": true,
 "rewrites": [
  {
   "source": "/blog/:slug",
   "destination": "/api/blog?slug=:slug"
  },
  {
   "source": "/blog/:slug/",
   "destination": "/api/blog?slug=:slug"
  },
  {
   "source": "/sitemap-blog.xml",
   "destination": "/api/sitemap"
  }
 ],
 "functions": {
  "api/blog.js": {
   "includeFiles": "{blog/index.html,veri/icerik.json}"
  },
  "api/sitemap.js": {
   "includeFiles": "veri/icerik.json"
  }
 },
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}
